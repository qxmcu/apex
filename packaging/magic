# Apex tournament multi-engine compression container format
# Format: 8-byte magic b"APEX\x01\x00\x00\x00", followed by uint16 flags, uint32 block_size
0       string          APEX\001\000\000\000    Apex compressed archive
>8      leshort         x                       (flags: 0x%04x
>10     lelong          x                       \b, block size: %d bytes)
!:mime  application/x-apex-archive
!:ext   apx
